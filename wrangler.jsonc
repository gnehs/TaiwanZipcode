{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taiwan-zipcode",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-04",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Only address pages and their images run the Worker. Everything else is
    // a static file, and unknown paths get the app, which sends visitors home.
    "run_worker_first": ["/a/*", "/og/*"]
  },
  "routes": [{ "pattern": "zipcode.gnehs.net", "custom_domain": true }],
  // Each address lives in its URL, so the Worker never logs request URLs.
  // Visits are counted in VISITS instead (see worker/index.ts).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "taiwan_zipcode_visits" }]
}
