{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taiwan-zipcode",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-04",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Only address pages run the Worker, for their metadata. The home page
    // and batch page are static files, as is anything with a dot.
    "run_worker_first": ["/*", "!/", "!/batch", "!/*.*"]
  },
  "routes": [{ "pattern": "zipcode.gnehs.net", "custom_domain": true }],
  "observability": { "enabled": true }
}
